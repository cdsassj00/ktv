[{"text":"네, 오늘 있었던 국무회의 비공개","start":0,"duration":6},{"text":"부분 브리핑하겠습니다.","start":3,"duration":6},{"text":"강의정 수석 대변입니다. 오늘 있었던","start":6,"duration":7},{"text":"제43회 국무회의 비공개 회의 부분에","start":9,"duration":7},{"text":"대해 브리핑하겠습니다.","start":13,"duration":6},{"text":"비공개 회의에서는 국무 조정실이","start":16,"duration":7},{"text":"123대 국정 과제 564개","start":19,"duration":8},{"text":"실천 과제 기준으로 521개가","start":23,"duration":7},{"text":"정상 추진돼 92%의 이행률을","start":27,"duration":7},{"text":"달성했다는 내용의 2026년 3분기","start":30,"duration":6},{"text":"국정 과제 추진 상황을","start":34,"duration":4},{"text":"보고했습니다.이","start":36,"duration":5},{"text":"이 대통령은 앞으로 공공 임대와 매입","start":38,"duration":7},{"text":"임대 등 전월세 대책을 구체적인 표로","start":41,"duration":8},{"text":"만들어 보고해 줄 것을 지시했습니다.","start":44,"duration":7},{"text":"역대 최저 산재 사망 성과","start":48,"duration":5},{"text":"보고를들은이 대통령은 고용노동부","start":51,"duration":6},{"text":"장관에게 산재 사망 감소율에 대해","start":54,"duration":6},{"text":"자세히 물었습니다.","start":57,"duration":5},{"text":"50인 미만 사업장의 산재 사고가","start":59,"duration":6},{"text":"크게 줄었다는 장관의 답변에 정부가","start":62,"duration":6},{"text":"집중적으로 관리하면 효과가 나타나기","start":65,"duration":6},{"text":"마련이라며 격려했습니다.","start":68,"duration":5},{"text":"이어 자살 사망자 수익 감소에","start":71,"duration":5},{"text":"대해서도 평가하며 OECD 평균치로","start":74,"duration":5},{"text":"가기 위해 더 노력해 달라","start":77,"duration":4},{"text":"당부했습니다.","start":79,"duration":5},{"text":"한편 지자체장들의 관심에 따라 감소","start":81,"duration":7},{"text":"수치가 달라진다는 국무총리의 보고에이","start":84,"duration":6},{"text":"대통령은 지방자치 단체에 여러","start":87,"duration":6},{"text":"인세티브를 주는 방안을 고려해서 자살","start":90,"duration":6},{"text":"사망자 감소 효과를 더 키워보자","start":94,"duration":5},{"text":"주문했습니다.이","start":96,"duration":5},{"text":"이 대통령은 북극항로 시범 운항 중인","start":99,"duration":6},{"text":"선박이 언제 귀향하는지 물은 후","start":102,"duration":6},{"text":"12일이라는 답변을 듣고 부산의","start":105,"duration":6},{"text":"미래에 큰 희망이자 미래의 깃발이 될","start":108,"duration":6},{"text":"수 있는 사업인만큼 북극로 10범문항","start":111,"duration":7},{"text":"관련해 신경 써 달라 당부했습니다.","start":114,"duration":7},{"text":"끝으로이 대통령은 국제통산질서의","start":117,"duration":7},{"text":"격변기에 CPTP의 전략적 가치가","start":120,"duration":8},{"text":"중요하다는 의견과 농수산업계의 우려가","start":124,"duration":7},{"text":"매우 크다는 의견이 제기되고 있는","start":128,"duration":6},{"text":"상황을 언급하며 정책 추진은","start":131,"duration":6},{"text":"농업인들의 신뢰 및 공감대를 전제로","start":134,"duration":6},{"text":"국익을 따져야 한다 강조했습니다.","start":137,"duration":7},{"text":"이어 결론을 정해 놓고 서두르지 말고","start":140,"duration":8},{"text":"원점에서 다시 대화를 시작해 볼 것을","start":144,"duration":5},{"text":"지시했습니다.","start":148,"duration":5},{"text":"이상입니다.","start":149,"duration":3},{"text":"네. 질문 있으면 질문에 대한 답 해","start":153,"duration":7},{"text":"드리겠습니다. 네.","start":157,"duration":5},{"text":">> 아, 네. 안녕하세요. 저 외신","start":160,"duration":5},{"text":"AFP 통신의 강진기라고 합니다.","start":162,"duration":4},{"text":"네. 국무회에 관련된 질문은","start":165,"duration":4},{"text":"아닌데요. 오늘 그 나온 영국 가디언","start":166,"duration":7},{"text":"보도에 따르면 지난 7월과 8월에 그","start":169,"duration":7},{"text":"한국 울산을 비롯한 한국 한구화","start":173,"duration":6},{"text":"해역에서 어 디젤을 중심으로 한 총","start":176,"duration":7},{"text":"17만 톤 이상의 연료가 유주선에","start":179,"duration":6},{"text":"선적되어서 이제 러시아 극동 지역으로","start":183,"duration":6},{"text":"이제 운송되었다고 보도가 되었는데요.","start":185,"duration":7},{"text":"이때 동원된 유조선에는 영국이랑 이유","start":188,"duration":7},{"text":"제재에 해당하는 선 어 유조선들도","start":192,"duration":6},{"text":"동원된 것으로 보도에 나왔습니다. 그","start":195,"duration":7},{"text":"대통령 시 청와대에서이 같은 연료","start":199,"duration":7},{"text":"운송 사실을 알고 계신지 궁금하고 또","start":202,"duration":7},{"text":"만약에이 운송 자체가 정부의 대시아","start":205,"duration":6},{"text":"제재 및 수출 통제 기조와 배치될","start":209,"duration":6},{"text":"소지는 없는지 궁금합니다. 또한 일부","start":212,"duration":6},{"text":"선박은 한국 당국의 이제 최종","start":215,"duration":5},{"text":"목적지가 러시아가 아니라 일본이나","start":217,"duration":5},{"text":"싱가폴이라고 이제 신고를 한 뒤에","start":220,"duration":5},{"text":"실제로는 러시아로 향한 것으로 보도가","start":223,"duration":5},{"text":"되었는데 관련한 그 정부 차원의","start":225,"duration":7},{"text":"조사나 어 제도 보안 여지가 있는지","start":228,"duration":6},{"text":"질문드리겠습니다.","start":232,"duration":5},{"text":">> 일단 관련된 사안은 현재 확인한 바가","start":234,"duration":5},{"text":"없고요. 그래서 확인을 좀 더 해","start":237,"duration":4},{"text":"봐야 될 사안으로 보입니다. 그리고","start":239,"duration":7},{"text":"확인한 이후에도이 사안에 대한 그","start":242,"duration":8},{"text":"답은 산업부가 되어야 할지 그 대응","start":246,"duration":6},{"text":"주체도 어 알아봐야 할 듯합니다.","start":250,"duration":4},{"text":"현재로는 확인된 사안이 아니라서","start":252,"duration":6},{"text":"확인부터 해 보겠습니다. 네.","start":254,"duration":6},{"text":"네.","start":258,"duration":3},{"text":"아, 오늘 경찰청과 중수청 그리고","start":262,"duration":5},{"text":"공소 대행들과 5찬에 오찬가진","start":265,"duration":6},{"text":"자리에서 새제도 안착 관련해서 당부의","start":267,"duration":5},{"text":"말씀 있으셨다고 했는데 구체적으로","start":270,"duration":4},{"text":"어떤 이야기 나누셨는지 궁금하고요.","start":273,"duration":4},{"text":"그리고 세기가 모두 공개롭게 대행","start":274,"duration":4},{"text":"체제인데 이와 관련해서 대통령 말씀","start":276,"duration":4},{"text":"있으셨는지도 궁금합니다.","start":278,"duration":6},{"text":">> 네. 현재 오찬을 나눈 일정 자체에","start":281,"duration":7},{"text":"대한 확인은 가능하지만 나눈 말씀은","start":285,"duration":6},{"text":"국무회의 과정에서 공개적으로 말씀하신","start":288,"duration":7},{"text":"말씀과 같은 취지의 어 새로 출범하는","start":291,"duration":8},{"text":"그런 기관에 대한 뭐 여러 가지 뭐","start":295,"duration":6},{"text":"말씀들을 하셨다. 그런다 국무회의에서","start":299,"duration":4},{"text":"공개된 발언 수준이라고 알고","start":301,"duration":5},{"text":"있습니다.","start":302,"duration":3},{"text":"다른도 질문 있으실까요? 네.","start":308,"duration":5},{"text":"예, SBS 김환진입니다. 그","start":314,"duration":4},{"text":"대통령께서 어제 부토 부동산 관련해서","start":315,"duration":4},{"text":"입장 연의어서 내셨었는데 오늘","start":317,"duration":4},{"text":"국무회에서는 별다른 말씀이 없으셨던","start":319,"duration":5},{"text":"거 같아서 혹시 비공개로 돌리고 나서","start":321,"duration":5},{"text":"언급 있으셨는지 좀 궁금하고요. 또","start":324,"duration":4},{"text":"대통령께서 어제 거론하신 부동산 내용","start":326,"duration":4},{"text":"관련해서 오세훈 시장이 오늘 오후에","start":328,"duration":4},{"text":"강도 비판을 계속했는데 혹시","start":330,"duration":4},{"text":"청와대에서 입장 갖고 계신지도","start":332,"duration":3},{"text":"여쭤보겠습니다.","start":334,"duration":3},{"text":">> 네. 예. 그 부분 아까 말씀드린","start":335,"duration":6},{"text":"것처럼 어 국무조정실 보고 내용에","start":337,"duration":8},{"text":"공공임대와 매입 임대 등 전세 관련한","start":341,"duration":7},{"text":"부분도 구체적인 표로 만들어 보고해","start":345,"duration":6},{"text":"줄 것을 지시했다.요 부분과 부합하는","start":348,"duration":6},{"text":"부분이고요. 오세원 시장의 발언은","start":351,"duration":5},{"text":"저희가 아직 확인도 안 되어서 좀","start":353,"duration":4},{"text":"확인을 해 봐야 될 것 같습니다.","start":356,"duration":4},{"text":"네.","start":357,"duration":8},{"text":"다른 또 질문 있으실까요? 네.","start":360,"duration":5},{"text":"네. 안녕하세요. 뉴스의","start":366,"duration":3},{"text":"김미경입니다. 어, 오늘 조이대","start":368,"duration":5},{"text":"대법원장이 국감장에서 좀 그 대법관","start":370,"duration":6},{"text":"제재청 관련해서 뭐 청와대나 국회가","start":373,"duration":4},{"text":"관여할 부분이 아니다. 뭐 이런","start":376,"duration":4},{"text":"입장을 발표를 했는데 청와대 쪽에서","start":377,"duration":4},{"text":"추가로 좀 설명해 주실 부분이","start":380,"duration":3},{"text":"있으시면 부탁드리겠습니다.","start":382,"duration":5},{"text":">> 네. 국회 국정 감사 중 나온 지의","start":383,"duration":6},{"text":"응답에서 아마 대답을 하신 걸로 알고","start":386,"duration":6},{"text":"있습니다. 어 국회에서 아마 입장 및","start":389,"duration":6},{"text":"여러 가지 의견들이 오고 갈 것으로","start":392,"duration":4},{"text":"알고 있고요. 청와대는 별도 입장이","start":394,"duration":6},{"text":"없고 기존에 이미 저희가 어 대법관","start":396,"duration":8},{"text":"제 임명에 관해서 입장을 밝힌 바","start":401,"duration":5},{"text":"있습니다. 그 입장을 확인하시면 될","start":404,"duration":5},{"text":"듯합니다.","start":406,"duration":3},{"text":"다른 질문도 있으실까요? 네.","start":411,"duration":4},{"text":"네. 저 내리신문 김영선입니다. 그","start":416,"duration":4},{"text":"CPTP","start":418,"duration":5},{"text":"그 원점에서 다시 대화라는 취지가 그","start":420,"duration":5},{"text":"CPTP를","start":423,"duration":4},{"text":"할지 말지 원점 어떤 제거토의 의미인","start":425,"duration":6},{"text":"건지 아니면 농업인 불만 사항을 좀","start":428,"duration":5},{"text":"더 수렴해서 어떤 뭐 가입 조건이나","start":431,"duration":4},{"text":"이런 다른 부분들을 좀 더","start":433,"duration":4},{"text":"살펴봐라라는 취지인 건지 좀 궁금한데","start":434,"duration":5},{"text":"어떻게 받아들이면 될지 궁금합니다.","start":437,"duration":6},{"text":"아예 결론을 정해 놓지 않고 원점에서","start":440,"duration":7},{"text":"이해 관계자들과 대화를 먼저 다시 해","start":443,"duration":7},{"text":"볼 예정입니다.","start":447,"duration":3},{"text":">> 네.","start":453,"duration":3},{"text":">> 네. 대변인님 아시아 경제 송승섭","start":457,"duration":5},{"text":"기자입니다. 그 대법권 공석이 계속","start":459,"duration":6},{"text":"이제 길어지는 분위기인데 그럼 지금","start":462,"duration":4},{"text":"현재 시점에서 청와대와 대법원","start":465,"duration":4},{"text":"사이에이 문제 해결을 위한 뭐","start":467,"duration":4},{"text":"소통이나 이런 것은 전혀 없는 것인지","start":469,"duration":4},{"text":"궁금합니다.","start":471,"duration":5},{"text":">> 네. 기존에 저희가 밝혔던 입장을 한","start":472,"duration":6},{"text":"번 더 말씀드립니다. 청와대는 국민의","start":475,"duration":5},{"text":"온전한 재판 청구권 행사의 지장이","start":478,"duration":5},{"text":"없도록 후석 절차에 만전을 기하고","start":481,"duration":6},{"text":"있습니다. 대법원장도 대법관의 장기","start":484,"duration":7},{"text":"공석으로 인한 국민의 재판받을 권리가","start":487,"duration":6},{"text":"침해되지 않도록 대법관 후보","start":490,"duration":5},{"text":"추천위원회의 추천 내용을 존중해서","start":493,"duration":6},{"text":"최대한 신속히 재청 절차를 진행해","start":496,"duration":6},{"text":"주기를 바랍니다. 기존 피지이고요.","start":498,"duration":5},{"text":"기존 피지에서 입장이 달라진 바","start":501,"duration":5},{"text":"없습니다.","start":503,"duration":3},{"text":"다른 또 질문 있으실까요?","start":508,"duration":4},{"text":">> 네.","start":514,"duration":4},{"text":">> 네. 구모인 충전인 최현교","start":517,"duration":4},{"text":"기자입니다. 오늘 대통령님께서","start":518,"duration":5},{"text":"국무회의에서 농촌 상생 기금 관련해서","start":521,"duration":6},{"text":"말씀을 해 주셨잖아요.","start":524,"duration":4},{"text":"그 내년에 2,억 원을 투입하고","start":526,"duration":4},{"text":"향후에 5,억 원을 추가해서 1조원을","start":528,"duration":4},{"text":"만들겠다고 이렇게 말씀을 해","start":530,"duration":5},{"text":"주셨는데요. 재원은 어떻게 됐고","start":532,"duration":7},{"text":"어디에 주로 쓰실 건지 궁금해하세요.","start":535,"duration":9},{"text":">> 네. 그 부분은 어 제가 좀 정확하게","start":539,"duration":7},{"text":"그 예상과 관련된 부분에 대해서","start":544,"duration":5},{"text":"말씀을 드리겠습니다. 아마 귀 그","start":546,"duration":6},{"text":"확보된 예상 관련된 이야기였을 거라","start":549,"duration":5},{"text":"보고요. 또 좀 더 자세하게 정확한","start":551,"duration":7},{"text":"사안은 추후 답변드리겠습니다.","start":554,"duration":4},{"text":">> 네.","start":567,"duration":3},{"text":">> 네. 저 YTN의 정인용이라고","start":568,"duration":5},{"text":"하는데요. 그 우리 군 간부 세 분이","start":570,"duration":5},{"text":"그 지뢰 폭발 피해 사고를 당한 것과","start":573,"duration":4},{"text":"관련해서 군당국이 북한의 지뢰였다고","start":575,"duration":5},{"text":"최종 결론 내렸고 앞서 대통령께서도","start":577,"duration":6},{"text":"필요한 조치를 해갈 거라고 하셨는데","start":581,"duration":6},{"text":"청와대 입장 설명 부탁드립니다.","start":583,"duration":7},{"text":">> 네. 최종적인 주사 결과가 나온 것을","start":587,"duration":7},{"text":"알고 있습니다. 군사적인 상흥 조치에","start":590,"duration":6},{"text":"대해서 질문을 많이 하고 계신데요.","start":594,"duration":6},{"text":"국방부에서 어 상응한 조치에 대한","start":596,"duration":5},{"text":"대응이 있을 예정이라고 알고","start":599,"duration":4},{"text":"있습니다. 국방부에서 나오는 대응","start":601,"duration":5},{"text":"조치가 곧 청와대의 입장과 다르지","start":604,"duration":5},{"text":"않음을 어 북방부 입장을 가음으로","start":606,"duration":6},{"text":"하겠다라고 말씀드리겠습니다.","start":609,"duration":4},{"text":"다른 질문도 있으실까요?","start":620,"duration":4},{"text":"네.","start":624,"duration":3},{"text":"아까 대법원장 관련한 또 입장을","start":627,"duration":4},{"text":"원칙적인 입장을 말씀을 해","start":630,"duration":4},{"text":"주셨는데요. 오늘 말씀 어 저희대","start":631,"duration":5},{"text":"대법원장의 말 중에 대법원과 청와대","start":634,"duration":5},{"text":"그 재가","start":636,"duration":5},{"text":"헌법상 근거가 없고 이게 원활한","start":639,"duration":4},{"text":"임명을 위해서 그동안 대법원장이","start":641,"duration":5},{"text":"협력을 해왔다이 부분하고 그다음에 그","start":643,"duration":6},{"text":"제재청 서면 재이 아무런 문제가","start":646,"duration":4},{"text":"없다는 이런 입장에 대해서는 좀","start":648,"duration":4},{"text":"어떻게 좀 보시는지요?","start":650,"duration":3},{"text":">> 네. 예, 별도 입장이 없고요.","start":652,"duration":4},{"text":"저희가 상세한 입장분을 이미 기발표한","start":654,"duration":5},{"text":"부분이 있으니 참조해 주시면 될","start":656,"duration":4},{"text":"듯합니다.","start":658,"duration":5},{"text":">> 네,","start":660,"duration":3},{"text":">> 안녕하세요. 조서일보 염재중","start":664,"duration":2},{"text":"기자입니다.","start":666,"duration":3},{"text":">> 네. 두 가지 질문 드리겠는데요.","start":666,"duration":5},{"text":"하나는 비서실장","start":669,"duration":5},{"text":"그 인선에 관해서","start":672,"duration":6},{"text":"혹시 확인해 주실 수 있는지 그다음에","start":675,"duration":6},{"text":"최근 조국신당하고","start":678,"duration":6},{"text":"그 검찰 관련해서 오늘도 반론이","start":681,"duration":5},{"text":"있었는데요.","start":684,"duration":4},{"text":"음. 정무화인하고","start":686,"duration":5},{"text":"그 대법","start":688,"duration":6},{"text":"조의대 대법장 같은 경우 민정인 같은","start":691,"duration":7},{"text":"경우 정무 수석이나 민정 수석의","start":695,"duration":5},{"text":"역할들이","start":698,"duration":4},{"text":"어떻게 대응을 하고 있는지","start":699,"duration":5},{"text":"궁금하거든요. 그 부분에서도 좀","start":702,"duration":4},{"text":"확인해 주실 수 있으면","start":704,"duration":5},{"text":"부탁드리겠습니다.","start":706,"duration":5},{"text":">> 네. 예. 첫 번째 질문은 많이","start":709,"duration":5},{"text":"여쭤보시는 사안들이긴 합니다만 인사","start":711,"duration":6},{"text":"관련해서 좀 확인을 드리기는","start":714,"duration":6},{"text":"어렵습니다. 좀 양해 부탁드리고요.","start":717,"duration":6},{"text":"그리고 두 번째는 좀 기나긴 정무적","start":720,"duration":8},{"text":"평가에 대한 말씀이신데 네. 어, 저","start":723,"duration":7},{"text":"제 역할을 다 하고 있을 거라 보지만","start":728,"duration":6},{"text":"저희가 좀 이걸 그","start":730,"duration":7},{"text":"관련 공지를 어제 대변인실해서 어,","start":733,"duration":6},{"text":"따로 언론인 분들에게 드리기도","start":737,"duration":5},{"text":"했습니다. 그 공지 관련해서 좀","start":739,"duration":4},{"text":"참조해 보시면 될 거 같고요. 그","start":741,"duration":5},{"text":"이후에 다른 반박들에 대해서는 별다른","start":743,"duration":7},{"text":"입장이 없습니다. 네,","start":746,"duration":5},{"text":"여기까지 하고 혹시 다른 질문","start":751,"duration":7},{"text":"있으시면 네. 영상 기자님들이","start":754,"duration":5},{"text":"정리해 주시면 그 이후에 받겠습니다.","start":761,"duration":5},{"text":"습니다.","start":763,"duration":3}]
