[{"text":"먼저 국민의뢰를 하겠습니다. 모두","start":4,"duration":5},{"text":"국기를 향해 주시기 바랍니다. 국기에","start":6,"duration":6},{"text":"대하여 경례.","start":9,"duration":5},{"text":"[음악]","start":12,"duration":2},{"text":"[음악]","start":17,"duration":2},{"text":">> [음악]","start":24,"duration":2},{"text":"[음악]","start":31,"duration":2},{"text":"[음악]","start":35,"duration":2},{"text":"[음악]","start":43,"duration":2},{"text":"[음악]","start":48,"duration":2},{"text":"[음악]","start":54,"duration":2},{"text":"[음악]","start":58,"duration":2},{"text":"[음악]","start":64,"duration":2},{"text":">> 바로 모두 자리 앉아 주시기","start":69,"duration":5},{"text":"바랍니다.","start":72,"duration":3},{"text":"제1회을지 국무회의부터","start":77,"duration":5},{"text":"시작하겠습니다. 대통령께서 개회선언과","start":79,"duration":6},{"text":"함께 모두 말씀을 하시겠습니다.","start":82,"duration":7},{"text":"네. 에, 제36회 국무회의를","start":85,"duration":7},{"text":"시작하겠습니다.","start":89,"duration":3},{"text":">> 대통령님, 제1회 국무회의를 선언해","start":93,"duration":4},{"text":"주셔야 되겠습니다.","start":96,"duration":2},{"text":">> 제 1회","start":97,"duration":2},{"text":">> 국무회을 일지 국무의","start":98,"duration":5},{"text":">> 아,지 아, 네. 제을지 제1회","start":99,"duration":7},{"text":"국회의를 시작하겠습니다.","start":103,"duration":4},{"text":"네. 우리 정부 출범 이후에 두","start":112,"duration":5},{"text":"번째을지 연습이 시작됐습니다.","start":114,"duration":5},{"text":"최근에 글로벌 안보 환경이 급변하고","start":117,"duration":6},{"text":"있고 또 전쟁 양상도 재례식 전투와","start":120,"duration":6},{"text":"테러, 사이버 공격 등이 복합","start":124,"duration":5},{"text":"작용하는 하이브리드 형태로 진화하고","start":126,"duration":5},{"text":"있습니다.","start":129,"duration":4},{"text":"군대뿐만 아니라 경제, 사회 모든","start":131,"duration":7},{"text":"분야에서 작은 빈틈도 발생하지 않도록","start":133,"duration":7},{"text":"안보 위협 대비에 늘 만전을 기해야","start":138,"duration":5},{"text":"되겠습니다.","start":140,"duration":4},{"text":"이번을 일지 연습 과정을 통해서","start":142,"duration":4},{"text":"우리의 방위태세를","start":144,"duration":5},{"text":"보다 면밀하게 점검 보완하고 또","start":147,"duration":6},{"text":"국가의 총체적 위기 대응 역량을 한층","start":149,"duration":7},{"text":"더 강화해 나가야겠습니다.","start":152,"duration":7},{"text":"강한 국방은 국민의 삶을 지키고","start":156,"duration":5},{"text":"대체불과 대한민국을 실현하기 위한","start":159,"duration":6},{"text":"가장 기본적인 토대입니다.","start":161,"duration":6},{"text":"아 현재 대한민국은 우리 국민","start":165,"duration":6},{"text":"여러분께서 너무 잘 아시는 것처럼","start":168,"duration":7},{"text":"세계 군사력 5위로 평가됩니다. 또","start":172,"duration":7},{"text":"방산 역량이 글로벌 4강으로","start":175,"duration":7},{"text":"평가되기도 하고 특히 대한민국의","start":179,"duration":7},{"text":"국방비 지출 수준이","start":182,"duration":7},{"text":"북한의 연간 총생산 국민총생산의","start":186,"duration":7},{"text":"1.4배에 이릅니다.","start":190,"duration":7},{"text":"어 국가의 실질적인 역량이라고 할 수","start":193,"duration":9},{"text":"있는 GDP 대비는 수십분의 정도로","start":197,"duration":8},{"text":"어 나타나고 있습니다.","start":201,"duration":6},{"text":"어 무기 체계와 전력 규모 측면에서","start":205,"duration":7},{"text":"보면 이미 우리 스스로를 지킬 영향이","start":208,"duration":6},{"text":"전 세계적으로 몇 번째 안에 들","start":212,"duration":5},{"text":"정도입니다. 차고 넘친다고 해도","start":214,"duration":6},{"text":"과언이 아닐 정도입니다.","start":216,"duration":5},{"text":"이러한 국방력을 좀 더 굳건하게","start":219,"duration":4},{"text":"만들려면","start":221,"duration":6},{"text":"작전 능력의 전방위적인 고도와","start":223,"duration":7},{"text":"또이를 함께 이뤄낼","start":227,"duration":5},{"text":"인재 육성 체계를 갖추는 것이","start":230,"duration":4},{"text":"필수입니다.이를","start":232,"duration":7},{"text":"위해서 어 전시 작전권의 임기 완수를","start":234,"duration":8},{"text":"당초 정부 계획에 따라서 차질없이","start":239,"duration":5},{"text":"추진해 나가야겠습니다.","start":242,"duration":7},{"text":"아울러 전장의 구분이 무의미해진 미래","start":245,"duration":7},{"text":"전에 대비하려면 통합적인 작전 능력을","start":249,"duration":7},{"text":"갖춘 간부도 길러내야 합니다.","start":252,"duration":6},{"text":"국군 사건학교 창설 준비 또한 흔들림","start":255,"duration":5},{"text":"없이 진행해 주기 바랍니다.","start":258,"duration":6},{"text":"경고한 한미동맹 또 자주적인 국방","start":261,"duration":6},{"text":"영량 광화는 서로 필요 충분","start":264,"duration":6},{"text":"조건입니다. 즉 동맹이 굳건해야","start":267,"duration":7},{"text":"안보의 근간이 더 튼튼해질 것이고 또","start":270,"duration":7},{"text":"우리 자신의 힘을 키워야 동맹으로서의","start":273,"duration":7},{"text":"가치와 필요성도 더 커지게 됩니다.","start":277,"duration":6},{"text":"보다 건설적이고 굳건한 한미동맹의","start":280,"duration":7},{"text":"미래를 상징할 핵잠수함 사업 추진에도","start":283,"duration":8},{"text":"속도를 내 주기 바랍니다.","start":287,"duration":6},{"text":"우리 총리님 어제 밤에 거제","start":290,"duration":4},{"text":"다녀오셨죠? 예.","start":293,"duration":3},{"text":">> 네.","start":294,"duration":3},{"text":"지난 주말에 남부 지방이 큰비가","start":295,"duration":5},{"text":"내렸습니다. 이번 폭으로 극심한","start":297,"duration":6},{"text":"감음을 겪던 일부 지방에","start":300,"duration":6},{"text":"국가 소방 동원영이 해제되긴 했지만","start":304,"duration":6},{"text":"여전히 감뭄은 계속되고 있습니다. 또","start":307,"duration":5},{"text":"한편으로","start":310,"duration":4},{"text":"어 반가운 비이긴 한데 너무 갑자기","start":311,"duration":5},{"text":"많이 내려서 심각한 수혜를 입은","start":314,"duration":6},{"text":"지역도 속출하고 있습니다. [콧방귀]","start":317,"duration":5},{"text":"우리 총리께서 다녀오시긴 했는데","start":320,"duration":7},{"text":"거제를 포함해서 피해가 큰 지역에에","start":322,"duration":7},{"text":"피해 대책 복구 대책을 잘 챙겨 주기","start":326,"duration":5},{"text":"바랍니다.","start":329,"duration":6},{"text":"이처럼 기록적인 폭염 감뭄 포구가","start":331,"duration":6},{"text":"동시에 나타나는 기상재난이 일상이","start":334,"duration":5},{"text":"되고 있습니다.","start":337,"duration":5},{"text":"이제는 기후 문제도 국가 안보","start":339,"duration":5},{"text":"측면에서 접근을 해야 될 때가","start":342,"duration":5},{"text":"됐습니다.이를","start":344,"duration":6},{"text":"이를 위해서는가 과거 기후에 맞춰졌던","start":346,"duration":6},{"text":"과거 기후에 맞춰졌던","start":350,"duration":4},{"text":"기후재난 시스템의 현대화가","start":352,"duration":4},{"text":"시급하겠습니다.","start":354,"duration":6},{"text":"댐미나 저수지 또 하천 재방 하수","start":356,"duration":7},{"text":"관로 등의 인프라를 극한적인 기후","start":360,"duration":6},{"text":"재난까지 대비할 수 있는 수준으로","start":363,"duration":5},{"text":"충분히 보강할 계획을 실질적으로","start":366,"duration":5},{"text":"추진해야 되겠습니다.","start":369,"duration":6},{"text":"인공지능 기술 활용과 기상위성 추가","start":371,"duration":5},{"text":"확보를 통해서","start":375,"duration":4},{"text":"기후 예측 모델을 한층 정교하는","start":376,"duration":6},{"text":"방안도 적극 검토해야 되겠습니다.","start":379,"duration":6},{"text":"어 전환 발생 후에 잘 수습하는 것도","start":383,"duration":5},{"text":"물론 중요한데이를","start":385,"duration":5},{"text":"미리 예측하고 선대적으로 대비하는","start":387,"duration":5},{"text":"국가 체계를 갖추는데 보다 주력해야","start":390,"duration":4},{"text":"되겠습니다.","start":393,"duration":4},{"text":"관련 예상과 인력 확충 또 제도","start":395,"duration":4},{"text":"계산에 만전을 개해 주시기","start":397,"duration":4},{"text":"부탁드립니다.","start":398,"duration":3},{"text":"어 철통 같은 국가 안보도 또","start":403,"duration":5},{"text":"빈틈없는 재난 대비도","start":405,"duration":6},{"text":"지속적인 경제 성장도 모두 국민의","start":408,"duration":5},{"text":"마음을 하나로 모으지 않으면 쉽지","start":411,"duration":4},{"text":"않습니다.이를","start":413,"duration":5},{"text":"이를 위해서는 주권자들의 목소리에 귀","start":415,"duration":6},{"text":"기울이고 서로의 작은 차이보다는 더","start":418,"duration":7},{"text":"큰 공통점을 찾아서 국민의 뜻을","start":421,"duration":6},{"text":"받들려는 노력을 꾸준히 기울여야","start":425,"duration":4},{"text":"되겠습니다.","start":427,"duration":4},{"text":"사람들의 의견은 다를 수 있습니다.","start":429,"duration":6},{"text":"또 갈등도 있을 수 있습니다.","start":431,"duration":7},{"text":"아 그러나 크게 보면 다 우리 모두는","start":434,"duration":7},{"text":"국민의 더 나은 삶, 국가의 더 나은","start":438,"duration":6},{"text":"미래를 위해서 힘을 모어야 될 운명","start":441,"duration":6},{"text":"공동체들입니다.","start":444,"duration":6},{"text":"당이 달라도 또 진영이 달라도 그리고","start":447,"duration":5},{"text":"서로 치열하게 경쟁을 버린 상대라","start":450,"duration":4},{"text":"하더라도","start":452,"duration":4},{"text":"국민과 나라를 위한 공동의 책임을","start":454,"duration":5},{"text":"짊어진 동반자들로서의","start":456,"duration":5},{"text":"그 책임은 다르지 않습니다. 함께","start":459,"duration":7},{"text":"손잡고 미래를 향해 끊임없이","start":462,"duration":7},{"text":"함께 나아가야 할 공동적인 책임을 진","start":465,"duration":6},{"text":"사람들입니다.","start":469,"duration":3},{"text":"사람들 사이에는","start":472,"duration":5},{"text":"동질성과 이질성이 병준합니다. 같은","start":474,"duration":6},{"text":"것도 있고 다른 점도 있죠.","start":477,"duration":5},{"text":"다른 점들을 찾기 시작하면 끊임없이","start":480,"duration":5},{"text":"벌어집니다. 또 같은 점을 찾기","start":482,"duration":4},{"text":"시작하면","start":485,"duration":4},{"text":"끊임없이 가까워지죠.","start":487,"duration":5},{"text":"국민의 삶에 계선 또 불공정과","start":489,"duration":6},{"text":"비정상에 중단없는 개혁 글로벌 초격차","start":491,"duration":6},{"text":"강국의 실현을 위해서","start":495,"duration":5},{"text":"국민의에","start":498,"duration":5},{"text":"권리를 대신 행사하는 정치권 모두가","start":500,"duration":5},{"text":"긴밀하게 협력하자라는 담부의 말씀을","start":503,"duration":4},{"text":"드립니다.","start":506,"duration":4},{"text":"국민의 삶을 외면하고 서로를 적대시","start":507,"duration":6},{"text":"하는 백회 무익한 정쟁보다는","start":510,"duration":5},{"text":"대체불과 대한민국을 만들기 위해 다","start":513,"duration":6},{"text":"함께 손을 맞잡을 때입니다.","start":515,"duration":7},{"text":"내란을 이겨낸 주권자가 탄생시킨","start":519,"duration":6},{"text":"우리 주 국민 주권 정부도 항상","start":522,"duration":7},{"text":"초심을 잊지 않고 국민과 함께 더불어","start":525,"duration":6},{"text":"심없이 전진하겠습니다.","start":529,"duration":4},{"text":"이상입니다.","start":531,"duration":3},{"text":">> 네. 의원 시민은 비공개로","start":533,"duration":4},{"text":"운영하겠습니다.","start":534,"duration":2}]
