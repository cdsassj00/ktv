[{"text":"가면 관리는 선재적인 대응이 무엇보다","start":0,"duration":6},{"text":"아주","start":3,"duration":5},{"text":"[음악]","start":6,"duration":2},{"text":">> 우리 정부는 역대 최대이 햇빛을 많이","start":9,"duration":6},{"text":"[음악] 상황에서 내년에 신설","start":12,"duration":4},{"text":">> 물가 관련된 부분만큼은 제대로","start":15,"duration":4},{"text":"관리해야 될 것 같습니다. 에너지","start":17,"duration":4},{"text":"관련해서 굉장히 [음악] 좀 걱정이","start":19,"duration":4},{"text":"많이 올라오고 있는데요. 굉장히","start":21,"duration":4},{"text":"중요한 부분이니까 잘 [음악] 주시해","start":23,"duration":6},{"text":"주시고 만약에 아 우리가 준비했던","start":25,"duration":7},{"text":"정책들 혹은 치원 책들에게 다 어","start":29,"duration":6},{"text":"소진되면 그 이후에 대안들은 있는","start":32,"duration":5},{"text":"건가요?","start":35,"duration":4},{"text":"[음악]","start":37,"duration":2},{"text":">> [음악]","start":41,"duration":4},{"text":">> 민족대명절인 추석이 열흘 앞으로","start":43,"duration":5},{"text":"다가왔습니다.","start":46,"duration":4},{"text":"그러나 중동전쟁 긴장이 다시","start":47,"duration":5},{"text":"고조되면서 국제 효과가 가파르게","start":49,"duration":5},{"text":"상승하는 등 물가 부담이 커지고","start":52,"duration":5},{"text":"있습니다. 우리 정부는 역대 최대","start":54,"duration":6},{"text":"규모의 성수품 공급을 포함한 추석","start":57,"duration":6},{"text":"민생 안정 대책을 발표했습니다.","start":60,"duration":6},{"text":"여기에 더해 성수품 할인 지원에","start":64,"duration":5},{"text":"900억 원을 추가로 투입하는 등","start":66,"duration":5},{"text":"추석 물가 안정의 최선을 다하고","start":68,"duration":5},{"text":"있습니다. 재경부, 농식품부 등","start":71,"duration":6},{"text":"관계부처은 정부 대책을 국민께 소상히","start":74,"duration":6},{"text":"알려 드리고 성수품이 제때 공급되는지","start":76,"duration":6},{"text":"포시 가격 위반 등 불공정 행위는","start":80,"duration":5},{"text":"없는지 현장 상황을 세심하게 살펴","start":82,"duration":6},{"text":"주시기 바랍니다. 오늘 국무회의에서는","start":85,"duration":6},{"text":"송전망설의 수용성 제고를 위한 방안이","start":88,"duration":6},{"text":"논의됩니다. 대한민국 대도약을 위한","start":91,"duration":5},{"text":"메가프로젝트 성공의 핵심 열쇠는","start":94,"duration":6},{"text":"전력의 적기 공급과 송전망의 조기","start":96,"duration":5},{"text":"구축에 달려 있다고 해도 과언이","start":100,"duration":4},{"text":"아닙니다. 특히 송전망은 지역","start":102,"duration":5},{"text":"주민들의 적극적인 협조가 무엇보다","start":104,"duration":6},{"text":"중요합니다. 정부는 송전망 확충의","start":107,"duration":6},{"text":"원칙은 흔들림없이 지키면서 주민부담을","start":110,"duration":6},{"text":"최소화하고 실질적인 혜택을 드릴 수","start":113,"duration":5},{"text":"있는 방안을 다각적으로 강고하고","start":116,"duration":5},{"text":"있습니다. 기후부는 시행령 등 후속","start":118,"duration":5},{"text":"조치를 꼼꼼히 챙기면서 지역 주민과의","start":121,"duration":6},{"text":"소통에 있어 마음에 다가간다는 자세로","start":123,"duration":7},{"text":"진정성 있게 임해 주시기 바랍니다.","start":127,"duration":6},{"text":"인플루언자를 비롯한 급성 호흡기","start":130,"duration":5},{"text":"감염병이 예년보다 이른 증가세를","start":133,"duration":6},{"text":"보이고 있습니다. 보건당국은 지난","start":136,"duration":6},{"text":"9월 11일 인플루엔자 유행 주의보를","start":139,"duration":6},{"text":"조기 발령했습니다. 감염 관리는","start":142,"duration":6},{"text":"선재적인 대응이 무엇보다 중요합니다.","start":145,"duration":5},{"text":"복지부와 질병청은 백신의 충분한","start":148,"duration":6},{"text":"확보와 함께 수급 성황 등을 고려해","start":150,"duration":6},{"text":"예방 접종 일정을 탄력적으로 검토해","start":153,"duration":5},{"text":"주시기 바랍니다. 특히 면역력이 약한","start":156,"duration":6},{"text":"영류화와 어르신, 만성 질환자 등","start":159,"duration":6},{"text":"고위염군이 적기의 예방 접종 및","start":161,"duration":5},{"text":"진료를 받으실 수 있도록 조치해","start":165,"duration":4},{"text":"주시기 바랍니다.","start":167,"duration":5},{"text":"이번 주에는 중앙아시아 5계국","start":169,"duration":5},{"text":"정상들과 많은 기업인들께서 우리나라를","start":171,"duration":6},{"text":"방문한 가운데 제1차 한 중앙아시아","start":174,"duration":6},{"text":"정상 외교가 진행되고 있습니다.","start":178,"duration":5},{"text":"중앙아시아에는 30여만 명의 고려인이","start":180,"duration":5},{"text":"여전히 살고 계시고 홍범도 장군을","start":183,"duration":5},{"text":"비롯한 많은 독립운동가들의 삶의","start":186,"duration":5},{"text":"터전이 되었던 곳으로 우리와는","start":188,"duration":5},{"text":"역사적인 인적인 유대가 깊은","start":191,"duration":5},{"text":"곳입니다. 또한 풍한 광물과 에너지","start":193,"duration":6},{"text":"자원을 보유하여 궁금망 다변화를 위한","start":196,"duration":6},{"text":"핵심 경제 협력국들이기도 합니다.","start":199,"duration":6},{"text":"그간 장착한 수준의 협력 체계를 정상","start":203,"duration":5},{"text":"회의로 격상시킨만큼","start":206,"duration":5},{"text":"외교부와 산업부 등 관계부처는","start":208,"duration":5},{"text":"가시적인 성과가 도출될 수 있도록","start":210,"duration":5},{"text":"후석 조치에 만전을 기해 주시기를","start":213,"duration":5},{"text":"바랍니다.","start":215,"duration":3},{"text":"이제 부처보고를 진행하겠습니다. 첫","start":220,"duration":6},{"text":"번째로 송전망설 수용성 제고방안에","start":223,"duration":6},{"text":"대해서 기후에너지 환경부 장관께서","start":226,"duration":5},{"text":"보고하시겠습니다.","start":228,"duration":5},{"text":"기후장관입니다.","start":231,"duration":4},{"text":"송전망 건설 수영성 제곱. 그러나","start":233,"duration":4},{"text":"전국적으로 성전망 건설에 대한 주민","start":235,"duration":5},{"text":"반대가 심화되면서 전력망 적기","start":237,"duration":5},{"text":"건설에도 차질이 우려되고 있습니다.","start":240,"duration":6},{"text":"일부 지역에서는 사업 전면 백지화","start":242,"duration":5},{"text":"전체 구간 지중화를 요구하는 등 갈등","start":245,"duration":5},{"text":"보고 드리겠습니다. 첫째 송전만","start":248,"duration":6},{"text":"건설에 따른 주민 영향을 최소화하도록","start":250,"duration":7},{"text":"하겠습니다. 기존 설로와 신설 설로로","start":254,"duration":5},{"text":"철탑을 줄일 수 있을 것으로","start":257,"duration":5},{"text":"예상됩니다.","start":259,"duration":3},{"text":"또한 주민 밀집 지역에 대해 지중화를","start":262,"duration":4},{"text":"확대하겠습니다. 한전에 자","start":265,"duration":7},{"text":">> 네. 의견 있으시면 말씀 주십시오.","start":267,"duration":5},{"text":">> 추가 확연 없으신가요?","start":275,"duration":4},{"text":"그 굉장히 중요한 과제라고","start":279,"duration":6},{"text":"생각됩니다. 지금 지중화가 되고 있는","start":283,"duration":5},{"text":"부분들도 긍정적이고 다만 여기에","start":286,"duration":5},{"text":"들어가는 이제 비용의 추가부담 관련된","start":288,"duration":6},{"text":"부분들이 좀 궁금한 부분이 있고요.","start":291,"duration":5},{"text":"그리고 또 하나는 지금 이미 있는","start":294,"duration":5},{"text":"설로와 통합해서 할 수 있는 부분들에","start":296,"duration":5},{"text":"대한 방안이 나온 것도 저는 정말","start":299,"duration":5},{"text":"중요한 부분이라고 생각합니다. 그리고","start":301,"duration":5},{"text":"사전에 주민들과의에","start":304,"duration":5},{"text":"소통을 통해서 방안을 마련하시는 이런","start":306,"duration":5},{"text":"여러 가지 부분들에 있어서 굉장히","start":309,"duration":7},{"text":"중요한 과제인만큼 장님께서 정극적으로","start":311,"duration":7},{"text":"한번 더 살펴 주시고 어느 부처가 더","start":316,"duration":7},{"text":"협조를 적극적으로 하시면 되나요?","start":319,"duration":4},{"text":">> 네. 이게 어 지금 농어천에서 가장","start":324,"duration":6},{"text":"관심이 많은게 햇빛 소득 마을인데이","start":328,"duration":5},{"text":"고압 어 성전망이 지나가는 데는 우선","start":330,"duration":5},{"text":"접속할 수 있도록 하고","start":333,"duration":4},{"text":">> 해피소득 마을에는 이제 정부가","start":335,"duration":6},{"text":"85%를 융자해 주고 15%","start":337,"duration":5},{"text":">> 네","start":341,"duration":1},{"text":">> 제가 한 말씀","start":342,"duration":2},{"text":">> 네","start":343,"duration":3},{"text":">> 저 시골에 살고 있어서 보니까 어","start":344,"duration":5},{"text":"햇빛소득 마을에 대해서 농촌 마을에","start":346,"duration":5},{"text":"관심이 큽니다. 예.","start":348,"duration":5},{"text":">> 제가 그 저 [콧방귀]","start":351,"duration":5},{"text":"지역 군수님하고 어딜가 봤냐면 농어천","start":353,"duration":7},{"text":"공사 소유 그 저수지 큰 저수지를","start":356,"duration":8},{"text":"방문했는데 그 재방하고 유효지 저","start":360,"duration":10},{"text":"밑에 그 제방 밑에 있는 그 부지 예","start":364,"duration":9},{"text":"그 순창에 전라북도 순창군","start":370,"duration":5},{"text":"강천산이라는데","start":373,"duration":5},{"text":"그 저저수지가 있는데 거기에 1m가","start":375,"duration":6},{"text":"정도는 설치할 수 있는 땅이더라고요.","start":378,"duration":6},{"text":"그런데 여기 농림부장관님 계신데","start":380,"duration":8},{"text":"농어천 공사가 굉장히 좀이","start":383,"duration":8},{"text":"비협조적이라고 할까요?","start":388,"duration":3},{"text":"[웃음]","start":391,"duration":4},{"text":">> 노천봉사는 대단히 협조적입니다. 네.","start":391,"duration":7},{"text":">> 예. 그 농어촌공사하고 계속 접촉을","start":395,"duration":6},{"text":"하는데 뭐 이빨도 안 들어간다 뭐 그","start":398,"duration":4},{"text":"[웃음]","start":401,"duration":2},{"text":"그런 얘기","start":402,"duration":3},{"text":">> 아마 이유가 있을 것이고요. 장관님","start":402,"duration":4},{"text":"그 말씀하신 거는 제가 한번","start":405,"duration":3},{"text":"살펴보도록 하겠습니다. 네.","start":406,"duration":4},{"text":"농어총사는 자체적으로이 햇빛소득 마을","start":408,"duration":5},{"text":"등을 비롯해서 우리 재생 에너지","start":411,"duration":2},{"text":"확산에","start":412,"duration":5},{"text":">> 그니까 그 지역 어에서 하는 거를","start":413,"duration":8},{"text":"일정 뭐 임대료 같은 걸 사용료 같은","start":418,"duration":6},{"text":"걸 받고 어 그 지역에 임대해 줘아서","start":421,"duration":7},{"text":"햇빛에 태양광을 조성할 수 있게 하면","start":424,"duration":5},{"text":"전국적으로","start":427,"duration":4},{"text":"햇빛 소득 마을이","start":429,"duration":4},{"text":"빠르게 확산되는데 크게 도움이 되지","start":431,"duration":5},{"text":"않을까? 농어촌 공사하고","start":433,"duration":6},{"text":"기호 에너지부 협력을 좀 해 주시면","start":436,"duration":5},{"text":"어떨까 싶습니다. 네.","start":439,"duration":4},{"text":"뭐 이번에","start":441,"duration":4},{"text":"내팔 참사 과정에서도 확인했습니다만","start":443,"duration":5},{"text":"기호 위기가 어 매우 급속하게","start":445,"duration":6},{"text":"진행되고 있기 때문에 햇빛이 비치는","start":448,"duration":5},{"text":"모든 곳의 확신 대책도 보고를","start":451,"duration":5},{"text":"드립니다. 그러니까 송전망을 추가로","start":453,"duration":4},{"text":"설치하지 않고도 여러 가지 방법을","start":456,"duration":4},{"text":"통해서 재생 에너지를 대폭 늘릴 수","start":458,"duration":5},{"text":"있는 그런 대책을 보고 드릴 예정으로","start":460,"duration":8},{"text":"있는데요. 이제 말씀 주신 대로네","start":463,"duration":5},{"text":">> 혹시 뭐 추가 회견한이 있으십니까?","start":468,"duration":3},{"text":"네.","start":470,"duration":5},{"text":">> 산업부입니다. 어 지금 오늘 발표해","start":471,"duration":6},{"text":"주신이","start":475,"duration":4},{"text":"성점 송전망 건설 수용성 제고","start":477,"duration":6},{"text":"방안이에 이런 방식으로 추진이 되면","start":479,"duration":7},{"text":"어 저희 정부에서","start":483,"duration":7},{"text":"어 HBM의 패블 용인에에","start":486,"duration":9},{"text":"7년에서 12년을 앞당기는 어 작업과","start":490,"duration":7},{"text":"그리고 선남권의 반도체을","start":494,"duration":6},{"text":"29년 말까지를 좀 완공을 하고자","start":497,"duration":8},{"text":"하는 목표를 를 어 큰 문제 없이이","start":501,"duration":8},{"text":"방식에 의해서 어 제대로 잘 진행될","start":505,"duration":6},{"text":"수 있을 거라고 예상됩니다. 저희","start":509,"duration":5},{"text":"산업부에서도 어 삼성전자 하이닉스와","start":511,"duration":7},{"text":"함께에 이러한 반도체 앱들 추진이","start":514,"duration":6},{"text":"차질없이 추진될 수 있도록 그렇게","start":517,"duration":6},{"text":"시행하겠습니다.네","start":520,"duration":3},{"text":">> 추가 회견 있으신가요?네","start":525,"duration":4},{"text":"네. 없으시면 재성 에너지 관련","start":530,"duration":6},{"text":"부분은 굉장히 중요하고 어 장관님","start":532,"duration":5},{"text":"기후 장관님 말씀 주신 것처럼","start":535,"duration":5},{"text":">> 다음번에 전체적으로 국민들께 재생","start":537,"duration":4},{"text":"에너지의 계획 관련된 부분들에 좀","start":540,"duration":5},{"text":"설명이 있고 그리고이 새로운 에너지를","start":542,"duration":6},{"text":"통해 새로운 소득이 나타나고 있는","start":545,"duration":5},{"text":"부분에 대한 설명들 이런 부분들도 다","start":548,"duration":7},{"text":"함께해서 재성 에너지로의 전환 그리고","start":551,"duration":6},{"text":"어 우리가 AI에 필요한 전력을","start":554,"duration":4},{"text":"어떻게 안정적으로 확보할 것인지에","start":556,"duration":4},{"text":"대한 설명을 조금 더 잘 드리는 것이","start":558,"duration":5},{"text":"좋겠다는 생각입니다. 네. 추가 회견","start":561,"duration":5},{"text":"없으시면 원한 대로 접수하겠습니다.","start":563,"duration":5},{"text":"다음은 중동전쟁 관련 비상 국정운영","start":566,"duration":6},{"text":"대응 및 대응 현황에 대해서 재정","start":568,"duration":6},{"text":"경제부 차관께서 보고하시겠습니다.","start":572,"duration":5},{"text":">> 예. 재정 경제부 2차관입니다.","start":575,"duration":5},{"text":"중동전쟁 관련 비상 국정 운영 및","start":577,"duration":5},{"text":"대응 현황에 대해서 보고드리겠습니다.","start":580,"duration":6},{"text":"먼저 동양입니다. 미이란 교전재계,","start":582,"duration":6},{"text":"사우디 송유관 피격 등으로 브랜트","start":585,"duration":7},{"text":"WTI 등 국제가 모두 100불대로","start":589,"duration":6},{"text":"상승하였고 천연가스 위연탄 등 국제","start":592,"duration":5},{"text":"에너지 가격도 상승세를 보이고","start":595,"duration":4},{"text":"있습니다.","start":597,"duration":4},{"text":"국고체 금리는 글로벌 인플레 우려","start":599,"duration":6},{"text":"심화 미국 등 주요 재정 건정성 악화","start":601,"duration":6},{"text":"우려와 미기중 금리 인상 가능성","start":605,"duration":6},{"text":"등으로 상승세를 지속하고 있으며","start":607,"duration":6},{"text":"환율은 1340원대에서","start":610,"duration":6},{"text":"등락하고 있습니다. 이러한 대회","start":614,"duration":6},{"text":"불확실성 확대에도 불구하고 수출과","start":616,"duration":5},{"text":"소비는 양호한 증가세를 지속하고","start":619,"duration":5},{"text":"있습니다. 수출은 9월 1일에서","start":621,"duration":6},{"text":"10일 349.7억불 7억불 전년","start":624,"duration":5},{"text":"동기 대비 82.6%","start":627,"duration":6},{"text":"% 증가한 수준으로 동기관 대비 역대","start":629,"duration":7},{"text":"최고 실적을 기록하였고 소비도 9월","start":633,"duration":7},{"text":"카드 사용액 등 소비 속보 지표","start":637,"duration":6},{"text":"모니터링 결과 현재까지 견조한","start":640,"duration":4},{"text":"증가세를 지속하고 있는 것으로","start":642,"duration":5},{"text":"보입니다. 다음 대응입니다. 먼저","start":644,"duration":6},{"text":"에너지 공급방입니다. 원유나프타는","start":647,"duration":6},{"text":"10월 물량을 작년 평균 대비 90%","start":650,"duration":7},{"text":"이상 확보하였으며 최고 가격제 매점","start":654,"duration":6},{"text":"매금지 등 수급 조치로 휘발류 경유","start":657,"duration":6},{"text":"모두 1800원대에서","start":660,"duration":6},{"text":"안정적인 수준을 지속하고 있습니다.","start":663,"duration":8},{"text":"주요 해상 운송로의 통활성 장기화를","start":666,"duration":8},{"text":"대비 대비하고 대체물량 도입 촉진을","start":671,"duration":6},{"text":"위해서 비축규 수압을 재가동하였으며","start":673,"duration":4},{"text":"[콧방귀]","start":677,"duration":5},{"text":"사우디 UA와 국제공동 비축물 확대를","start":677,"duration":6},{"text":"지속적으로 협의 중입니다.","start":681,"duration":6},{"text":"금융입니다. 9월 17일 미 FOMC","start":684,"duration":6},{"text":"회의 결과에 따른 금융 외한 시점","start":687,"duration":5},{"text":"변동성 모니터링에 대한 대응을","start":690,"duration":4},{"text":"강화하겠습니다.","start":692,"duration":5},{"text":"확대 거시 경제 금융회의 등을 통해","start":694,"duration":6},{"text":"시장 상황을 면밀히 점검하고 국고체","start":697,"duration":6},{"text":"금리 상승세 확대 시 긴급 바이백","start":700,"duration":5},{"text":"실시 등 시장 안정 조치 시행을","start":703,"duration":6},{"text":"검토하겠습니다. 물가입니다. 추석","start":705,"duration":6},{"text":"민생 안정 대책 및 보안 방안을","start":709,"duration":5},{"text":"차질없이 집행하겠습니다.","start":711,"duration":6},{"text":"농축 수산물 할인 지원 예산집 전액","start":713,"duration":7},{"text":"집행 노력을 강화하고 19대 성수품","start":716,"duration":9},{"text":"정부 비축 계약 재배 물량을 공급하여","start":721,"duration":8},{"text":"추석 바가지 요금 등 물가 관리 합동","start":725,"duration":6},{"text":"현장 점검도 강화하는 등 적극","start":728,"duration":6},{"text":"대응하도록 하겠습니다. 일자리입니다.","start":732,"duration":6},{"text":"청년 일자리 회역 방안 등 27년","start":735,"duration":5},{"text":"예산안에 반영된 주요 일자리 사업","start":737,"duration":6},{"text":"현황 점검 집행 준비 대책의 홍보","start":740,"duration":7},{"text":"사전 안내 등의 만전을 기하겠습니다.","start":744,"duration":5},{"text":"이상입니다.","start":747,"duration":5},{"text":">> 네. 지금 에너지 관련해서 굉장히 좀","start":749,"duration":6},{"text":"걱정이 많이 올라오고 있는데요.","start":752,"duration":5},{"text":"지금까지 최고획제 관련해서 저희가","start":754,"duration":6},{"text":"물가를 잘 관리해는 했는데 지금 이번","start":757,"duration":6},{"text":"주에 결정해야 되는 상황이죠.","start":760,"duration":6},{"text":"산업부에서 설명 부탁드리겠습니다.","start":763,"duration":6},{"text":">> 예, 그렇습니다. 어, 우선 총리님","start":766,"duration":5},{"text":"말씀하신에","start":769,"duration":7},{"text":"최고 가격제가 이번 주 금요일부터","start":771,"duration":8},{"text":"어, 다음 달에 대한 어, 최고","start":776,"duration":6},{"text":"가격제가 다시 고시가 돼야 됩니다.","start":779,"duration":7},{"text":"어, 지금 어, 중동의 상황이 에,","start":782,"duration":8},{"text":"홍해뿐 호르몬주뿐만이 아니라 홍해까지","start":786,"duration":6},{"text":"더 문제가 되고 있어서 어,","start":789,"duration":6},{"text":"수급뿐만이 아니라 가격까지도 같이","start":792,"duration":5},{"text":"걱정이 되고 있는 상황입니다.이 이","start":795,"duration":6},{"text":"부분에 대해서는 어 여러 가지 상황","start":797,"duration":6},{"text":"민생 안정뿐만이 아니라 물가인 미치는","start":801,"duration":6},{"text":"영향까지를 고려해서 어","start":803,"duration":8},{"text":"금요일 전에에 최고 가격제에 대해서","start":807,"duration":5},{"text":"어 발표할 수 있도록 그렇게","start":811,"duration":3},{"text":"준비하겠습니다.","start":812,"duration":5},{"text":"총님. 그리고 어 이번 어제 월요일","start":814,"duration":7},{"text":"날 아침에 정유사들 뿐만이 아니라","start":818,"duration":8},{"text":"해운사 또 어 사우디의 대사관까지","start":822,"duration":8},{"text":"같이 저희들이 다시 한번에 점검을 좀","start":826,"duration":7},{"text":"했습니다. 그 부분 쪽에 대해서는에","start":829,"duration":7},{"text":"사우디 정부에 공식적인 발표는","start":833,"duration":7},{"text":"없습니다만 전체적으로 한 2내지 3주","start":836,"duration":8},{"text":"또는 한 4내지 5주 정도의에이","start":840,"duration":4},{"text":"동서 파이프라인 부분 쪽이에 물량","start":844,"duration":5},{"text":"차질이 사우디 내에 있는 거","start":848,"duration":6},{"text":"같습니다. 어이 정도 기간만 문제가","start":850,"duration":8},{"text":"된다라고 하면 어 저희들의 10","start":854,"duration":6},{"text":"지금의 문제되는 물량은에","start":858,"duration":6},{"text":"딜리버리를 생각합 운송을 생각하면","start":860,"duration":6},{"text":"11월 정도부터 영향을 미치는 건데에","start":863,"duration":6},{"text":"그 정도에서 그친다라고 하면은에","start":867,"duration":5},{"text":"수급에는 큰 문제는 없을 것","start":869,"duration":4},{"text":"같습니다. 또는 그 이유가 된다","start":871,"duration":6},{"text":"하더라도 어 장기화될 가능성까지를","start":874,"duration":8},{"text":"대비해서 비중동산 쪽의 원유가 수급성","start":877,"duration":7},{"text":"도입을 통해서 수급성 문제가 없도록","start":882,"duration":7},{"text":"어 그렇게 준비토록 하겠습니다.","start":884,"duration":5},{"text":"[콧방귀]","start":889,"duration":3},{"text":">> 네. 굉장히 중요한 부분이니까 잘","start":889,"duration":6},{"text":"주시해 주시고 그 지금 최요 가격제로","start":892,"duration":6},{"text":"석유 관련된 가격을 잘 관리하다","start":895,"duration":5},{"text":"보니이 사용량이 급증하고 있다. 이런","start":898,"duration":4},{"text":"이야기들도 있는데 실제 상황은","start":901,"duration":3},{"text":"어떤가요?","start":903,"duration":5},{"text":">> 예.에 에, 오늘 언론에서 일부 어","start":904,"duration":6},{"text":"이야기가 어, 제기가 됐습니다만 다시","start":907,"duration":6},{"text":"한번 말씀드립니다. 어, 최고","start":911,"duration":7},{"text":"가격제가 실시됐던 3월 2주부터 어,","start":914,"duration":7},{"text":"9월 첫째 주까지 기준으로 어,","start":917,"duration":6},{"text":"주유소 판매량을 기준으로 했을 때","start":920,"duration":7},{"text":"직접 국민들이 주유소에 가서 사는 그","start":924,"duration":6},{"text":"주유소의 판매 물량 기준으로 했을 때","start":927,"duration":5},{"text":"에, 휘발류는 2.1%가 1%가","start":930,"duration":6},{"text":"감소가 되고 어 경유는 8.6%가","start":932,"duration":5},{"text":"6%가","start":935,"duration":5},{"text":"판매량이 감소를 했습니다. 어이","start":937,"duration":8},{"text":"부분에 대해서는 통계의 시점차이나 어","start":940,"duration":8},{"text":"기준이 좀 다른 데서 오는 올 수","start":945,"duration":5},{"text":"있는 문제인 거 같습니다.이 부분에","start":948,"duration":5},{"text":"대해서는에 저희 산업부에서 어 보도","start":950,"duration":6},{"text":"설명 자료를 통해서 명확하게에","start":953,"duration":5},{"text":"국민들께 설명드릴 수 있도록 그렇게","start":956,"duration":4},{"text":"조치하겠습니다.네","start":959,"duration":5},{"text":"네. 지금 에너지 관련해서이 석유","start":960,"duration":6},{"text":"관련 물가가 사실어 우리나라는 좀","start":963,"duration":5},{"text":"안정적으로 관리되고 있지만 다른","start":966,"duration":4},{"text":"나라는 굉장히","start":968,"duration":5},{"text":"그 가격 상승폭도 크고 전체 물가에","start":970,"duration":5},{"text":"미치는 해외 국가들 같은 경우 그런","start":973,"duration":6},{"text":"상황인데요.이 부분은 좀 제대로 물가","start":975,"duration":5},{"text":"관련된 부분만큼은 제대로 관리해야 될","start":978,"duration":5},{"text":"것 같습니다. 추석물과 관련해서도","start":981,"duration":5},{"text":"지금 재경부에서 계속 정리 잘 해","start":984,"duration":7},{"text":"주고 계신데 관련해서 만약에","start":986,"duration":8},{"text":"우리가 준비했던 그런 어떤 그 정책들","start":990,"duration":7},{"text":"혹은 지원 책들에게 이게 다","start":994,"duration":5},{"text":"소진되면 그 이후에 대안들은 있는","start":997,"duration":6},{"text":"건가요?","start":999,"duration":3},{"text":">> 예. 재경부에서는 9월 1일 추세","start":1004,"duration":5},{"text":"민생 안정 대책 및 보안 방안을 9월","start":1006,"duration":5},{"text":"9일 날 또 발표했습니다. 어","start":1009,"duration":5},{"text":"일단은이 방안이 아직까지는 이제 집행","start":1011,"duration":5},{"text":"중이기 때문에이 방언을 충분히","start":1014,"duration":6},{"text":"집행하고 만일 이것에도 불구하고 뭐","start":1016,"duration":6},{"text":"유과의 급격한 상승이라든지 아니면","start":1020,"duration":5},{"text":"대회 여건으로 인한 불안이 지속될","start":1022,"duration":5},{"text":"경우에는 또 추가적인 대책도 다른","start":1024,"duration":4},{"text":"부처와 함께 고려해 보도록","start":1027,"duration":3},{"text":"하겠습니다.","start":1028,"duration":5},{"text":">> 네. 네. 그리고 금리 관련해서도","start":1030,"duration":6},{"text":"사실 미국의 FOMC 결정이 지금","start":1033,"duration":6},{"text":"중요해진만큼 금융당국에서도","start":1036,"duration":5},{"text":"상황을 좀 제대로 살펴봐 주시면","start":1039,"duration":5},{"text":"좋겠습니다. 혹시 추가 의견","start":1041,"duration":3},{"text":"있으십니까?","start":1044,"duration":2},{"text":">> 네. 노동부입니다. 노동부","start":1045,"duration":3},{"text":"[목을 가다듬음] 장관입니다.","start":1046,"duration":2},{"text":">> 네.","start":1047,"duration":4},{"text":"지난 8월 28일 발표된 청년 일자리","start":1048,"duration":6},{"text":"회복 방안에 대해서 오늘도 저희들이","start":1051,"duration":6},{"text":"청년들에 한해서는 일경 조건을","start":1054,"duration":6},{"text":"삭제해서 곧바로 청년 첫 지역 지원","start":1057,"duration":5},{"text":"제도를","start":1060,"duration":5},{"text":"받을 수 있도록 하고","start":1062,"duration":6},{"text":">> 네. 그럼 추가 회견 없으시면 원한","start":1065,"duration":6},{"text":"대로 접수하겠습니다. 다음은 인플루엔","start":1068,"duration":6},{"text":"등 호흡기 감염병 발생 및 대응에","start":1071,"duration":4},{"text":"대해서 질병 관리 청장께서","start":1073,"duration":4},{"text":"보고하시겠습니다.","start":1075,"duration":4},{"text":">> 네. 보고드리겠습니다. 인플루엔자와","start":1077,"duration":4},{"text":"코로나1 발생 동향과 대응 상황","start":1079,"duration":4},{"text":"말씀드리겠습니다.","start":1081,"duration":4},{"text":"인플루엔자가 이례적으로 이른 시기에","start":1083,"duration":3},{"text":"빠르게 위","start":1085,"duration":5},{"text":">> 의견 있으시면 말씀 부탁드립니다.","start":1086,"duration":4},{"text":">> 혹시 복지부 장관님 뭐 관련해서 말씀","start":1093,"duration":6},{"text":"있으실까요? 네. 복지부는 요양","start":1096,"duration":6},{"text":"시설이나 사회복지 시설 같은 건강","start":1099,"duration":5},{"text":"취약계층이 있는 집단 시설의 감염","start":1102,"duration":5},{"text":"관리를 좀 더 강화하고 말씀 주신","start":1104,"duration":5},{"text":"대로 접종이 백신이 확보되는 대로","start":1107,"duration":5},{"text":"조기 접종하도록 하겠습니다. 그리고","start":1109,"duration":6},{"text":"인플루엔 치료제인 항바이러스제 또","start":1112,"duration":6},{"text":"코로나1 치료제에 대해서 수급 상황을","start":1115,"duration":6},{"text":"좀 모니터링하고 공급에 문제가 없도록","start":1118,"duration":6},{"text":"질병청과 협의하면서 치료제 관리도","start":1121,"duration":6},{"text":"강화하도록 하겠습니다.","start":1123,"duration":6},{"text":"네. 지금 어린이는 인플루엔자가 다음","start":1127,"duration":6},{"text":"주부터 접종이 시작되고 어르신은","start":1129,"duration":7},{"text":"10월 12일부터 시작되는데 그 추석","start":1133,"duration":7},{"text":"연휴가 시작되면 좀 확산세가 있을 것","start":1136,"duration":6},{"text":"같은데 접종시기를 좀 단기될 필요는","start":1139,"duration":3},{"text":"없나요?","start":1142,"duration":3},{"text":">> 네. 보고에 말씀드렸던 것처럼 어린이","start":1143,"duration":3},{"text":"접종은 원할","start":1145,"duration":4},{"text":">> 있으신가요?","start":1146,"duration":3},{"text":"없으시면 아 원한 대로","start":1149,"duration":4},{"text":"접수하겠습니다. 다음은 대통령님","start":1151,"duration":6},{"text":"프랑스 국빈 방문 주요 성과 및 후속","start":1154,"duration":6},{"text":"조치 계획에 대해서 외교부 창관께서","start":1157,"duration":5},{"text":"보고해 주시겠습니다.네 [콧방귀]","start":1160,"duration":5},{"text":">> 대통령님의 프랑스 방문 주요 성과와","start":1162,"duration":5},{"text":"후속 계획을 아 보고드리겠습니다.","start":1164,"duration":5},{"text":"이번 방문은 이유 G7 핵심국인","start":1167,"duration":5},{"text":"프랑스와 5개월 만에 상호 국빈","start":1169,"duration":5},{"text":"방문을 완성함으로써 글로벌 전략적","start":1172,"duration":5},{"text":"동반자 관계를 내시라 하고 우리의","start":1175,"duration":5},{"text":"대유럽 외교 지평을 확장했다는데 의가","start":1177,"duration":5},{"text":"있습니다. 주요 방문 성과입니다. 총","start":1179,"duration":5},{"text":"16권의 협력 무건이 이번 방문","start":1182,"duration":4},{"text":"계기에 체결되었습니다. 우선 국방","start":1184,"duration":4},{"text":"안보분 분야 실질 협력을","start":1186,"duration":4},{"text":"강화했습니다. 국방 비밀 정보 보호","start":1188,"duration":6},{"text":"협정이 개정되었고 하반기 중에 공군간","start":1190,"duration":6},{"text":"합동 훈련과 해군간 상호 기향도 추진","start":1194,"duration":5},{"text":"할 예정입니다. 아울러 호회적 방산","start":1197,"duration":5},{"text":"협력 사업 발굴를 위해 노력하고","start":1200,"duration":4},{"text":"호르무주 안정화를 위한 다자기어","start":1202,"duration":4},{"text":"논의도 지속해 나가기로 했습니다.","start":1203,"duration":5},{"text":"경제 산업 분화에서는 비즈니스 라운드","start":1206,"duration":5},{"text":"테이블 개최와 장급 산업 전략대화","start":1208,"duration":6},{"text":"출범, 기업 지원 및 지식재선 분야,","start":1211,"duration":5},{"text":"협력 문건 체결 등을 통해 양국 산업","start":1214,"duration":5},{"text":"협력을 고도화하고 우리 기업의 현지","start":1216,"duration":4},{"text":"증출을 지원할 수 있는 토대를","start":1219,"duration":4},{"text":"마련하였습니다.","start":1221,"duration":5},{"text":"첨단 기술 협력 기반도 확하였습니다.","start":1223,"duration":5},{"text":"AI 반도체, 양자분야 협력 구체화를","start":1226,"duration":6},{"text":"위한 M와 삼성전자와 미스트랄 AI","start":1228,"duration":6},{"text":"투자 협약이 체결되었습니다. 또한","start":1232,"duration":5},{"text":"양국이 강점을 갖는 원자력 분야를","start":1234,"duration":5},{"text":"비롯해 바이오, 우주 등 분야에서도","start":1236,"duration":5},{"text":"다수의 협력 물건을 체결하였습니다.","start":1239,"duration":4},{"text":"양국 국민이 체감할 수 있는 결류","start":1241,"duration":4},{"text":"기반도 확대하였습니다. 지난 4월","start":1243,"duration":4},{"text":"서명한 워킹 홀리데이 협정이","start":1245,"duration":5},{"text":"10월부터 발효되고 항공 협정","start":1247,"duration":5},{"text":"개정으로 항공사관 협력을 더욱","start":1250,"duration":5},{"text":"효율화되어 양국 국민들의 교류와","start":1252,"duration":5},{"text":"진출이 더욱 편리해질 것입니다. 치한","start":1254,"duration":5},{"text":"협력 합의민 척일도 양국 경찰관 직접","start":1257,"duration":6},{"text":"협력 책에도 구축하였습니다.","start":1260,"duration":6},{"text":"국제영화 영상 정상회인 리미에 서밋","start":1263,"duration":6},{"text":"및 공당 우장국 수임과 영상산업","start":1266,"duration":5},{"text":"진출을 위한 리미에르 파트너십 체결를","start":1268,"duration":4},{"text":"통해 문화 강국으로서 대한민국의","start":1271,"duration":5},{"text":"국조적 위상을 제고하고 K콘텐츠의","start":1273,"duration":5},{"text":"유력 진출을 확대를 위한 겨두벌을","start":1276,"duration":5},{"text":"확립하였습니다. 마지막으로 후속 조치","start":1278,"duration":5},{"text":"계획입니다. 이번 방문 성과를 토대로","start":1281,"duration":5},{"text":"프랑스와 전략적 협력을 지속 강화해","start":1283,"duration":5},{"text":"나가고 특히 현재 문한 혐의 중인","start":1285,"duration":5},{"text":"상호 군수 지원 협정은 조속히 협의를","start":1288,"duration":4},{"text":"마무리하여 가급적 빠른 시일 내에","start":1290,"duration":5},{"text":"체결될 수 있도록 추진하겠습니다.","start":1293,"duration":5},{"text":"또한 10월 중에 관계부차 합동 후속","start":1296,"duration":4},{"text":"조치 점검 회의를 개최하여 이번","start":1298,"duration":5},{"text":"방문객이 체결된 각 협력 무건이","start":1300,"duration":5},{"text":"신속하게 발효 이행되고 구체적인","start":1302,"duration":4},{"text":"성과로 이어지도록 후속 조치 이행에","start":1304,"duration":5},{"text":"만전을 기하도록 하겠습니다. 차기 한","start":1307,"duration":5},{"text":"불 외교 장관 전략되어도 저기에","start":1310,"duration":4},{"text":"개처하여 프랑스 측의 충실한 후속","start":1312,"duration":4},{"text":"조치 이행을 동료해 나가도록","start":1314,"duration":5},{"text":"하겠습니다. 이상 예 이상입니다.","start":1315,"duration":5},{"text":">> 네. 관련해서 의견이 있으면 말씀","start":1318,"duration":4},{"text":"주십시오.","start":1321,"duration":3},{"text":">> 네. 문재부장관입니다.","start":1323,"duration":2},{"text":">> 네.","start":1324,"duration":2},{"text":">> 그 AI","start":1324,"duration":4},{"text":"OTT로 미디어 환경이 지금 급변하고","start":1326,"duration":2},{"text":"있는","start":1328,"duration":5},{"text":">> 네. 혹시 다녀오신 광청님. 네.","start":1328,"duration":7},{"text":">> 네. [콧방귀] 어 그 정부관 M","start":1333,"duration":5},{"text":"측면에서는 뭐 AI 반도체 양자에","start":1335,"duration":4},{"text":"대한 내용들이 주로 다뤄졌었는데","start":1338,"duration":5},{"text":"실질적으로이 외에도네","start":1339,"duration":8},{"text":">> 혹시 추가 확연 있으십니까?","start":1343,"duration":4},{"text":"저는 자료 보면서 뭐 영화 부분의","start":1347,"duration":5},{"text":"협력도 굉장히 의미 있었다는 생각이","start":1350,"duration":5},{"text":"들고 또 하나는 사실 양자 수학","start":1352,"duration":5},{"text":"과학이 4대 과기원과 프랑스","start":1355,"duration":6},{"text":"대학들과의 한국 그 협력 이런","start":1357,"duration":6},{"text":"부분들의 그 기초 관련된 부분에","start":1360,"duration":5},{"text":"굉장히 좀 단단한 프랑스와","start":1363,"duration":4},{"text":"우리나라의과","start":1365,"duration":4},{"text":"관련된 부분의 협력이 틀이","start":1367,"duration":4},{"text":"만들어졌다는 걸 굉장히 의미 있다는","start":1369,"duration":4},{"text":"생각이 들었습니다. 관련해서 잘 챙겨","start":1371,"duration":7},{"text":"주시고 지난 어 그 저 우리 정부","start":1373,"duration":7},{"text":"시작하고 나서 대통령께서 계속","start":1378,"duration":5},{"text":"정상회를 하시면서 나왔던 과제들을 좀","start":1380,"duration":6},{"text":"다시 한번 정리를 하고 거기에 대한","start":1383,"duration":5},{"text":"후속 작업들이 어떻게 진도가 나가고","start":1386,"duration":5},{"text":"있는지는 외계부에서 한번 전체적으로","start":1388,"duration":5},{"text":"지금 이제 리스터블 정리를 좀 할","start":1390,"duration":4},{"text":"때가 된 거 같습니다. 그래서 지금","start":1393,"duration":4},{"text":"잘 하고 계시지만이 부분에 대한","start":1395,"duration":5},{"text":"성과와 그리고 지금 계속해서 AI","start":1398,"duration":5},{"text":"기본 사회나 AI 관련된 이야기들이","start":1400,"duration":5},{"text":"많이 나가고 있는데이 부분에 대해서는","start":1403,"duration":4},{"text":"부총님께서 과위 부총님께서 한번","start":1405,"duration":5},{"text":"정리하셔서 앞으로의 진행 사항들","start":1407,"duration":6},{"text":"점검해 주시면 좋겠습니다. 네. 그럼","start":1410,"duration":6},{"text":"추가 회견 없으시면 원한 대로","start":1413,"duration":5},{"text":"접수하겠습니다.","start":1416,"duration":5},{"text":"그러면 의원심의 진행하겠습니다.","start":1418,"duration":5},{"text":"의원심은 비공개로 운영되니 언론인","start":1421,"duration":4},{"text":"여러분께서는 회의 진행에 협조해","start":1423,"duration":5},{"text":"주시기 바랍니다.","start":1425,"duration":3},{"text":"[음악]","start":1429,"duration":2},{"text":"A TV","start":1432,"duration":4},{"text":"[음악]","start":1434,"duration":2}]
